# Linktech Engineering Vault Template
#
# This vault is organized by application.
#
# Each application owns its own section and is responsible for
# consuming only the credentials beneath its application key.
#
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
#
# Store the vault in a secured directory.
#
# Recommended permissions:
#
#   Vault directory : 0700
#   Vault file      : 0600
#
# Examples:
#
#   RUNUPDATES_VAULT_PATH=/secure/vault/vault.yml
#   RUNUPDATES_VAULT_PASSWORD_FILE=/secure/vault/vault.pass
#
#   MEDICAL_VAULT_PATH=/secure/vault/vault.yml
#   MEDICAL_VAULT_PASSWORD_FILE=/secure/vault/vault.pass
#
# The password file must contain only the vault password.
#
# ----------------------------------------------------------------------
# GENERAL RULES
# ----------------------------------------------------------------------
#
# * Inventory files must not contain credentials.
# * Passwords belong in the vault.
# * Usernames belong in the vault.
# * SSH keys belong in the vault.
# * API tokens belong in the vault.
# * Database credentials belong in the vault.
# * Certificates and private keys belong in the vault.
#
# Applications should consume only their own section.
#
# ----------------------------------------------------------------------
# RunUpdates
# ----------------------------------------------------------------------

runupdates:

  sudo_user: "CHANGE_ME"

  keyfile: "~/.ssh/runupdates"

  sudo_pass: "CHANGE_ME"

  # Optional SSH password fallback
  #
  # password: "CHANGE_ME"

# ----------------------------------------------------------------------
# Medical
# ----------------------------------------------------------------------

medical:

  database:

    server: "localhost"

    database: "Medical"

    username: "CHANGE_ME"

    password: "CHANGE_ME"

  encryption:

    key: "CHANGE_ME"

# ----------------------------------------------------------------------
# LicenseGen
# ----------------------------------------------------------------------

licensegen:

  database:

    server: "localhost"

    database: "LicenseGen"

    username: "CHANGE_ME"

    password: "CHANGE_ME"

  signing:

    private_key: "/path/to/private.key"

    public_key: "/path/to/public.key"

# ----------------------------------------------------------------------
# BotScanner
# ----------------------------------------------------------------------

botscanner:

  ssh:

    username: "CHANGE_ME"

    keyfile: "~/.ssh/botscanner"

# ----------------------------------------------------------------------
# NMS_Tools
# ----------------------------------------------------------------------

nmstools:

  notifications:

    email_user: "CHANGE_ME"

    email_password: "CHANGE_ME"

  weather:

    api_key: "CHANGE_ME"

# ----------------------------------------------------------------------
# Future Applications
# ----------------------------------------------------------------------

future_application:

  example_key: "CHANGE_ME"